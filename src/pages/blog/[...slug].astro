---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Comments from '../../components/Comments.astro';
import Picture from '../../components/Picture.astro';
import { SITE } from '../../consts';
import { readingTime, formatDate } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const minutes = readingTime(post.body ?? '');
const path = `/blog/${post.id}/`;
const ogImage = data.ogImage ?? data.featuredImage;

const pageUrl = new URL(path, SITE.url).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.metaDescription ?? data.summary,
    image: new URL(data.featuredImage, SITE.url).href,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: { '@type': 'Person', name: data.author },
    publisher: {
      '@type': 'Organization',
      name: SITE.title,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/images/logo.jpg` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    keywords: data.tags.join(', '),
  },
];

// When a post carries academic metadata, emit Google Scholar (Highwire)
// citation_ meta tags + a ScholarlyArticle JSON-LD block so the paper is
// discoverable and citable from this page.
const sch = data.scholarly;
const citationMeta = sch
  ? [
      { name: 'citation_title', content: data.title },
      { name: 'citation_author', content: data.author },
      { name: 'citation_publication_date', content: sch.publicationDate },
      { name: 'citation_publisher', content: sch.publisher },
      { name: 'citation_doi', content: sch.doi },
      { name: 'citation_pdf_url', content: sch.pdfUrl },
      { name: 'citation_abstract_html_url', content: pageUrl },
      { name: 'citation_public_url', content: pageUrl },
      ...(sch.keywords.length
        ? [{ name: 'citation_keywords', content: sch.keywords.join('; ') }]
        : []),
    ]
  : [];

if (sch) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    headline: data.title,
    name: data.title,
    description: sch.abstract ?? data.metaDescription ?? data.summary,
    datePublished: data.date.toISOString(),
    author: {
      '@type': 'Person',
      name: data.author,
      ...(sch.authorOrcid
        ? {
            identifier: `https://orcid.org/${sch.authorOrcid}`,
            url: `https://orcid.org/${sch.authorOrcid}`,
          }
        : {}),
    },
    publisher: { '@type': 'Organization', name: sch.publisher },
    identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: sch.doi },
    sameAs: sch.landingUrl ?? `https://doi.org/${sch.doi}`,
    url: pageUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    keywords: sch.keywords.join(', '),
    isBasedOn: `https://doi.org/${sch.doi}`,
  });
}
---
<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.metaDescription ?? data.summary}
  image={ogImage}
  type="article"
  canonical={pageUrl}
  jsonLd={jsonLd}
  meta={citationMeta}
  showTopbar={true}
>
  <article class="article">
    <div class="shell">
      <header class="article__header" data-reveal>
        {data.categories[0] && <div class="eyebrow">{data.categories[0]}</div>}
        <h1>{data.title}</h1>
        <div class="article__meta">
          <span>By {data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </div>
      </header>

      <figure class="article__hero" data-reveal data-reveal-delay="1">
        <Picture
          src={data.featuredImage}
          alt={data.featuredImageAlt || data.title}
          width={1000}
          height={600}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="prose" data-reveal>
        <Content />
      </div>

      {data.tags.length > 0 && (
        <div class="prose">
          <div class="tag-row">
            {data.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        </div>
      )}

      <div class="prose">
        <ShareButtons title={data.title} path={path} />
      </div>

      <Comments />

      <div class="prose" style="text-align:center;margin-top:3rem">
        <a class="button button--ghost" href="/blog/">← Back to the journal</a>
      </div>
    </div>
  </article>
</BaseLayout>
