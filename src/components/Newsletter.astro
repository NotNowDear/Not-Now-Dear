---
import { NEWSLETTER, SITE, SOCIAL } from '../consts';
const action = `https://buttondown.com/api/emails/embed-subscribe/${NEWSLETTER.buttondownUsername}`;
---
<section class="section panel" id="join">
  <div class="shell newsletter-grid">
    <div data-reveal>
      <div class="eyebrow eyebrow--gold">Join the readers</div>
      <h2>Good things,<br /><em>sent gently.</em></h2>
      <p class="lede" style="margin-top:1.4rem">
        News from the book, fresh journal notes, and the occasional lovely thing.
        No noise — and you can leave whenever you like.
      </p>
      <p class="form-note">
        Prefer email? Write to
        <a class="contact-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <div class="instagram-qr" style="margin-top:1.6rem">
        <img src="/images/insta-qr-code.png" alt="Instagram QR code for Not Now Dear" width="96" height="96" loading="lazy" />
        <div class="ig-follow">
          <span>Scan the code — or tap to follow:</span>
          <a class="ig-button" href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Follow Not Now Dear on Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.86.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.27.06-1.65.07-4.86.07s-3.58 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.42a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.21 15.58 2.2 15.2 2.2 12s0-3.58.07-4.85c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.42 2.21 8.8 2.2 12 2.2m0 1.8c-3.14 0-3.51.01-4.75.07-.9.04-1.38.19-1.7.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.13.32-.28.8-.32 1.7C4.01 9.16 4 9.53 4 12s.01 2.84.07 4.08c.04.9.19 1.38.32 1.7.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.13.8.28 1.7.32 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c.9-.04 1.38-.19 1.7-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.61.07-4.08s-.01-2.84-.07-4.08c-.04-.9-.19-1.38-.32-1.7a2.86 2.86 0 0 0-.69-1.06 2.86 2.86 0 0 0-1.06-.69c-.32-.13-.8-.28-1.7-.32C15.51 4.01 15.14 4 12 4m0 3.06A4.94 4.94 0 1 1 7.06 12 4.94 4.94 0 0 1 12 7.06m0 8.14A3.2 3.2 0 1 0 8.8 12a3.2 3.2 0 0 0 3.2 3.2m5.15-8.34a1.15 1.15 0 1 1-1.15-1.15 1.15 1.15 0 0 1 1.15 1.15"/></svg>
            <span>Follow on Instagram</span>
          </a>
        </div>
      </div>
    </div>

    <div data-reveal data-reveal-delay="1">
      <form class="subscribe-form" id="subscribe-form" action={action} method="post" target="_blank">
        <div class="field">
          <label for="nl-name">Name</label>
          <input id="nl-name" type="text" name="metadata__name" autocomplete="name" placeholder="Your name" />
        </div>
        <div class="field">
          <label for="nl-email">Email <span aria-hidden="true">*</span></label>
          <input id="nl-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
        </div>
        <div class="field">
          <label for="nl-country">Country</label>
          <input id="nl-country" type="text" name="metadata__country" autocomplete="country-name" placeholder="Where you're reading from" />
        </div>
        <label class="consent">
          <input type="checkbox" id="nl-consent" name="consent" required />
          <span>
            I'd like to receive occasional emails about Not Now Dear and I agree
            to the <a href="/privacy/">privacy note</a>. (GDPR — double opt-in.)
          </span>
        </label>
        <input type="hidden" name="embed" value="1" />
        <button class="button button--ruby" type="submit">Subscribe</button>
        <p class="form-note">You'll receive a confirmation email to complete your sign-up.</p>
      </form>

      <div class="form-success" id="subscribe-success" role="status" aria-live="polite">
        <div class="seal" aria-hidden="true">✦</div>
        <h3>Almost there.</h3>
        <p class="form-note">
          We've sent a confirmation email — click the link inside to complete
          your sign-up. Welcome, nearly.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('subscribe-form') as HTMLFormElement | null;
  const success = document.getElementById('subscribe-success');
  if (form && success) {
    form.addEventListener('submit', (e) => {
      const consent = form.querySelector<HTMLInputElement>('#nl-consent');
      if (consent && !consent.checked) return; // let native validation handle it
      // Progressive enhancement: submit quietly, then show the confirmation.
      if (window.fetch) {
        e.preventDefault();
        // URL-encoded body — exactly what Buttondown's embed endpoint expects.
        const data = new URLSearchParams(new FormData(form) as any);
        fetch(form.action, {
          method: 'POST',
          body: data,
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        })
          .catch(() => {})
          .finally(() => {
            form.style.display = 'none';
            success.classList.add('is-visible');
          });
      }
      // If fetch is unavailable, the native POST (target=_blank) proceeds.
    });
  }
</script>

<style>
  .ig-follow { display: flex; flex-direction: column; gap: 0.6rem; }
  .ig-follow > span { font-family: var(--sans); font-size: 0.78rem; color: var(--muted); }
  .ig-button {
    display: inline-flex; align-items: center; gap: 0.5rem; width: fit-content;
    font-family: var(--sans); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em;
    color: #fff; padding: 0.55rem 1rem 0.55rem 0.8rem; border-radius: 999px;
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), filter 0.3s var(--ease);
  }
  .ig-button svg { width: 18px; height: 18px; fill: currentColor; }
  .ig-button:hover { color: #fff; transform: translateY(-2px); box-shadow: var(--shadow-soft); filter: brightness(1.08); }
</style>
