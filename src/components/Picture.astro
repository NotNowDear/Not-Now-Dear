---
// Serves an optimised WebP with the original PNG/JPG as automatic fallback.
// The .webp files are produced at build time by scripts/prepare-assets.mjs.
// Pass the ORIGINAL path (e.g. /images/front-cover.png); the WebP path is derived.
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  class?: string;
}
const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  class: className,
} = Astro.props;

const isRaster = /\.(png|jpe?g)$/i.test(src);
const webp = src.replace(/\.(png|jpe?g)$/i, '.webp');
---
{isRaster ? (
  <picture>
    <source srcset={webp} type="image/webp" />
    <img src={src} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} decoding={decoding} class={className} />
  </picture>
) : (
  <img src={src} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} decoding={decoding} class={className} />
)}
