---
import { COMMENTS } from '../consts';
const configured = COMMENTS.enabled && !COMMENTS.repoId.startsWith('YOUR_');
---
{COMMENTS.enabled && (
  <section class="comments-wrap" data-reveal>
    <div class="rule"><span>Join the conversation</span></div>
    {configured ? (
      <script
        src="https://giscus.app/client.js"
        data-repo={COMMENTS.repo}
        data-repo-id={COMMENTS.repoId}
        data-category={COMMENTS.category}
        data-category-id={COMMENTS.categoryId}
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="transparent_dark"
        data-lang="en"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      />
    ) : (
      <p class="form-note" style="text-align:center;margin-top:1.5rem">
        Comments &amp; reactions will appear here once Giscus is connected —
        see <code>DOCUMENTATION.md</code>.
      </p>
    )}
  </section>
)}
